# STF environment — copy to .env.local and fill in values.
# .env.local is gitignored; never commit real credentials.

# ---- Supabase (authentication + private file storage) ----
# Project: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://mcwuzmzslujnlzagijhc.supabase.co
# Publishable (anon) key — safe for the browser by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Postgres (Prisma) ----
# Supabase dashboard → Settings → Database → Connection string.
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL:   direct connection used by migrations and seeds (CLI).
# For simple local development both may point at the direct connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mcwuzmzslujnlzagijhc.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mcwuzmzslujnlzagijhc.supabase.co:5432/postgres

# ---- Development only ----
# Renders the app shell with fixture data and NO real authentication.
# Ignored unless NODE_ENV=development. Values: employee | admin | hr |
# manager | owner. See SECURITY-NOTES.md before using.
# STF_DEV_FAKE_SESSION=employee
